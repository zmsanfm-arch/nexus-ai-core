{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai-core/schemas/experiment-plan.schema.json",
  "title": "NEXUS Strategy Experiment Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "strategy_id",
    "strategy_version",
    "objective",
    "data_scope",
    "partitions",
    "walk_forward",
    "variants",
    "cost_model",
    "acceptance_criteria",
    "reproducibility"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 3
    },
    "strategy_id": {
      "type": "string"
    },
    "strategy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "data_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "timeframe_coverage",
        "start",
        "end",
        "dataset_id",
        "dataset_version"
      ],
      "properties": {
        "instrument": {
          "type": "string"
        },
        "timeframe_coverage": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "dataset_id": {
          "type": "string"
        },
        "dataset_version": {
          "type": "string"
        }
      }
    },
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "holdout"
      ],
      "properties": {
        "train": {
          "$ref": "#/$defs/period"
        },
        "validation": {
          "$ref": "#/$defs/period"
        },
        "holdout": {
          "$ref": "#/$defs/period"
        },
        "leakage_policy": {
          "type": "string"
        }
      }
    },
    "walk_forward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "folds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "folds": {
          "type": "integer",
          "minimum": 0
        },
        "train_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "parameters"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "parameter_bounds": {
            "type": "object"
          },
          "change_rationale": {
            "type": "string"
          }
        }
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spread_source",
        "commission_model",
        "slippage_model",
        "swap_model"
      ],
      "properties": {
        "spread_source": {
          "type": "string"
        },
        "commission_model": {
          "type": "object"
        },
        "slippage_model": {
          "type": "object"
        },
        "swap_model": {
          "type": [
            "object",
            "null"
          ]
        },
        "stress_scenarios": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_trades",
        "minimum_profit_factor",
        "maximum_drawdown",
        "minimum_expectancy_r",
        "robustness_required"
      ],
      "properties": {
        "minimum_trades": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_profit_factor": {
          "type": "number",
          "minimum": 0
        },
        "maximum_drawdown": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimum_expectancy_r": {
          "type": "number"
        },
        "robustness_required": {
          "type": "boolean"
        },
        "additional_metrics": {
          "type": "object"
        },
        "criteria_owner": {
          "enum": [
            "user",
            "central_policy",
            "research_default"
          ]
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "code_revision",
        "random_seed",
        "configuration_hash"
      ],
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "code_revision": {
          "type": "string"
        },
        "random_seed": {
          "type": "integer"
        },
        "configuration_hash": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}