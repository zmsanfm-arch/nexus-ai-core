# Build with --build-arg PYTHON_BASE_IMAGE=python:3.12-slim@sha256:<verified-digest>
ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE}
ARG PYTHON_BASE_IMAGE
RUN case "$PYTHON_BASE_IMAGE" in *@sha256:*) ;; *) echo "PYTHON_BASE_IMAGE must be digest-pinned" >&2; exit 1 ;; esac
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/nexus
LABEL com.nexus.component="browser-egress-proxy" com.nexus.egress-policy="allowlist-v1"
COPY app/services/browser_egress_proxy.py /opt/nexus/browser_egress_proxy.py
USER 65532:65532
EXPOSE 3128
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD python -c "import socket; s=socket.create_connection(('127.0.0.1',3128),2); s.close()"
ENTRYPOINT ["python", "/opt/nexus/browser_egress_proxy.py"]
