# Copy to .env.production on the host. Never commit real values.
APP_ENV=production
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
# URL-encode reserved characters in the database password.
DATABASE_URL=postgresql+psycopg://nexus:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/nexus
NEXUS_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
NEXUS_API_CLIENT_ID=production-api-client
NEXUS_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
NEXUS_ADMIN_ID=primary-admin
# Leave model provider values empty until external model use is approved.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=45

# Worker starts only with: docker compose --profile worker up -d
# Enable only after the model provider has been approved and configured.
NEXUS_WORKER_ID=nexus-worker-1
NEXUS_WORKER_POLL_SECONDS=2
NEXUS_WORKER_LEASE_SECONDS=600
NEXUS_WORKER_MAX_ATTEMPTS=3
NEXUS_WORKER_RETRY_DELAY_SECONDS=30
