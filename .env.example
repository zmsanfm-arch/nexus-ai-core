APP_ENV=development
DATABASE_URL=sqlite:///./data/nexus.db
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=45
NEXUS_ADMIN_TOKEN=
NEXUS_ADMIN_ID=
NEXUS_API_TOKEN=
NEXUS_API_ID=api-client
NEXUS_CORS_ORIGINS=

# API abuse controls (per-process baseline; use shared gateway limits in multi-instance production)
NEXUS_RATE_LIMIT_PER_MINUTE=120
NEXUS_MAX_REQUEST_BYTES=6291456

# Provider-agnostic OIDC mode (set NEXUS_AUTH_MODE=oidc only after configuring all values)
NEXUS_AUTH_MODE=static
NEXUS_OIDC_ISSUER=
NEXUS_OIDC_AUDIENCE=
NEXUS_OIDC_JWKS_URL=
NEXUS_OIDC_ADMIN_GROUP=
NEXUS_OIDC_OPERATOR_GROUP=
NEXUS_OIDC_GROUPS_CLAIM=groups

# Optional local PostgreSQL Compose profile; set unique values in your private .env
POSTGRES_DB=nexus
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=
